{
  "name": "cover-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/rotate-dist-bak.mjs --stash",
    "build": "vue-tsc -b && vite build && npm run 体检闸门",
